<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ComponentCatalogWinUI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ComponentCatalogWinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ComponentCatalogWinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:ComponentCatalogWinUI.Models"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    MinWidth="0"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:SelectedCardValueConverter x:Key="SelectedCardValueConverter" />
    </Page.Resources>

    <Grid
        x:Name="HomeLayoutRoot"
        ColumnSpacing="0"
        HorizontalAlignment="Stretch"
        MinWidth="0"
        Padding="20,16,20,16"
        SizeChanged="HomeLayoutRoot_SizeChanged">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition IsStaggeringEnabled="False" />
                <RepositionThemeTransition IsStaggeringEnabled="False" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FilterColumn" Width="0" />
            <ColumnDefinition x:Name="ResultsColumn" Width="*" />
            <ColumnDefinition x:Name="EditorColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <!-- This single filter host moves into the flyout outside ExtraWide mode. -->
        <Border
            x:Name="FilterPane"
            Grid.Column="0"
            Style="{StaticResource SidebarSurfaceStyle}">
            <ScrollViewer
                Padding="0,0,8,0"
                Background="Transparent"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled">
            <StackPanel Spacing="14">
                <Border
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                        CornerRadius="14">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="分类" />
                            <ComboBox
                                x:Name="SidebarMajorCategoryComboBox"
                                Header="大类"
                                DisplayMemberPath="Label"
                                ItemsSource="{x:Bind MajorCategoryFilters, Mode=OneWay}"
                                SelectedValue="{x:Bind SelectedMajorCategoryId, Mode=TwoWay}"
                                SelectedValuePath="Id"
                                SelectionChanged="SidebarMajorCategoryComboBox_SelectionChanged" />
                            <ComboBox
                                x:Name="SidebarSubcategoryComboBox"
                                Header="子类"
                                DisplayMemberPath="Label"
                                IsEnabled="{x:Bind IsSubcategoryFilterEnabled, Mode=OneWay}"
                                ItemsSource="{x:Bind SubcategoryFilters, Mode=OneWay}"
                                SelectedValue="{x:Bind SelectedSubCategoryId, Mode=TwoWay}"
                                SelectedValuePath="Id"
                                SelectionChanged="SidebarSubcategoryComboBox_SelectionChanged" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                        CornerRadius="14">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="结构化筛选" />
                        <ComboBox
                            x:Name="SidebarPackageComboBox"
                            Header="封装"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="SidebarPackageComboBox_SelectionChanged" />
                        <ComboBox
                            x:Name="SidebarOwnedComboBox"
                            Header="持有状态"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="SidebarOwnedComboBox_SelectionChanged" />
                        <TextBox
                            x:Name="SidebarAttributeTextBox"
                            Header="属性过滤"
                            PlaceholderText="例如 voltage=3.3V"
                            TextChanged="SidebarAttributeTextBox_TextChanged" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </Border>

        <Grid
            x:Name="ResultsPane"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            MinWidth="0"
            RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="SearchToolbar"
                Margin="0,0,0,8"
                ColumnSpacing="12"
                HorizontalAlignment="Stretch"
                MinWidth="0"
                RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="SearchToolbarActionRow" Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SearchInputColumn" Width="*" />
                    <ColumnDefinition x:Name="FilterButtonColumn" Width="Auto" />
                    <ColumnDefinition x:Name="NewComponentButtonColumn" Width="Auto" />
                </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="SearchBox"
                PlaceholderText="搜索型号、封装、参数"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged"
                VerticalAlignment="Center" />
                <StackPanel
                    x:Name="SearchToolbarActions"
                Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="FilterButton"
                        Click="FilterButton_Click"
                        Content="筛选"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="NewComponentButton"
                Click="NewComponentButton_Click"
                Content="新建空白元件"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
        </Grid>

            <Grid x:Name="StatsPanel" Grid.Row="1" ColumnSpacing="12" MinWidth="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

                <Border x:Name="TotalCountCard" Style="{StaticResource SectionCardStyle}" Padding="18,16" MinWidth="0" Visibility="Collapsed">
                <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="目录总数" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock FontSize="30" FontWeight="SemiBold" Text="{x:Bind TotalCount, Mode=OneWay}" />
                </StackPanel>
            </Border>

                <Border x:Name="OwnedCountCard" Grid.Column="1" Style="{StaticResource SectionCardStyle}" Padding="18,16" MinWidth="0" Visibility="Collapsed">
                <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="已持有" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock FontSize="30" FontWeight="SemiBold" Text="{x:Bind OwnedCount, Mode=OneWay}" />
                </StackPanel>
            </Border>

                <Border x:Name="CategoryCountCard" Grid.Column="2" Style="{StaticResource SectionCardStyle}" Padding="18,16" MinWidth="0" Visibility="Collapsed">
                <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="分类数" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock FontSize="30" FontWeight="SemiBold" Text="{x:Bind CategoryCount, Mode=OneWay}" />
                </StackPanel>
            </Border>

                <TextBlock
                    x:Name="CompactStatsSummary"
                    Grid.ColumnSpan="3"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="{x:Bind CompactStatisticsSummary, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    VerticalAlignment="Center"
                    Visibility="Visible" />
        </Grid>

            <Border
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                MinWidth="0"
                Style="{StaticResource SectionCardStyle}">
                <Grid HorizontalAlignment="Stretch" MinWidth="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="检索结果" />

                <GridView
                    x:Name="ComponentGrid"
                    Grid.Row="1"
                    ItemsSource="{x:Bind FilteredItems, Mode=OneWay}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                    Margin="0,18,0,0"
                        MinWidth="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollMode="Enabled"
                        SelectionChanged="ComponentGrid_SelectionChanged"
                    SelectionMode="Single"
                    SizeChanged="ComponentGrid_SizeChanged"
                    Visibility="{x:Bind ResultListVisibility, Mode=OneWay}">
                        <GridView.ItemContainerTransitions>
                            <TransitionCollection>
                                <RepositionThemeTransition IsStaggeringEnabled="False" />
                                <EntranceThemeTransition IsStaggeringEnabled="False" />
                                <AddDeleteThemeTransition />
                            </TransitionCollection>
                        </GridView.ItemContainerTransitions>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0,0,12,12" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="UseSystemFocusVisuals" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewItem">
                                        <Grid CornerRadius="14" Background="Transparent">
                                                <ContentPresenter
                                                    x:Name="ContentPresenter"
                                                              Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                <Border
                                                    x:Name="HoverBackground"
                                                    Background="{ThemeResource SystemAccentColor}"
                                                    CornerRadius="14"
                                                    IsHitTestVisible="False"
                                                    Opacity="0" />
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                        <VisualStateGroup.Transitions>
                                                            <VisualTransition GeneratedDuration="0:0:0.2" />
                                                        </VisualStateGroup.Transitions>
                                                        <VisualState x:Name="Normal">
                                                            <VisualState.Setters>
                                                                <Setter Target="HoverBackground.Opacity" Value="0" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    <VisualState x:Name="PointerOver">
                                                        <VisualState.Setters>
                                                            <Setter Target="HoverBackground.Opacity" Value="0.08" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Pressed">
                                                        <VisualState.Setters>
                                                            <Setter Target="HoverBackground.Opacity" Value="0.15" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                        <VisualState x:Name="PointerOverSelected">
                                                        <VisualState.Setters>
                                                                <Setter Target="HoverBackground.Opacity" Value="0.08" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="SelectedPointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Target="HoverBackground.Opacity" Value="0.08" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                        <VisualState x:Name="PressedSelected">
                                                        <VisualState.Setters>
                                                                <Setter Target="HoverBackground.Opacity" Value="0.15" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="SelectedPressed">
                                                            <VisualState.Setters>
                                                                <Setter Target="HoverBackground.Opacity" Value="0.15" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GridView.ItemContainerStyle>

                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Stretch" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="model:ComponentItem">
                                <Grid
                                    Height="112"
                                    HorizontalAlignment="Stretch"
                                    PointerPressed="ComponentCard_PointerPressed">
                            <Border
                                        x:Name="CardSurface"
                                        Padding="10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource SelectedCardValueConverter}, ConverterParameter=Brush}"
                                        BorderThickness="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource SelectedCardValueConverter}, ConverterParameter=Thickness}"
                                CornerRadius="14"
                                HorizontalAlignment="Stretch">
                                        <Grid RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                                    Width="34"
                                                    Height="34"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                            CornerRadius="10"
                                            VerticalAlignment="Top">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Glyph="{x:Bind CategoryGlyph}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock FontSize="16" FontWeight="SemiBold" MaxLines="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="12" MaxLines="1" Style="{StaticResource SectionCaptionTextStyle}" Text="{x:Bind PartNumber}" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="4" Opacity="0.7" Visibility="{x:Bind LocationVisibility}">
                                                        <FontIcon FontSize="11" Glyph="&#xE81D;" VerticalAlignment="Center" />
                                                        <TextBlock FontSize="11" MaxLines="1" Text="{x:Bind Location}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                                                <Border MinHeight="24" Padding="8,2" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="12" VerticalAlignment="Center">
                                            <TextBlock FontSize="11" Text="{x:Bind Category}" />
                                        </Border>
                                                <Border MinHeight="24" Padding="8,2" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="12" VerticalAlignment="Center">
                                            <TextBlock FontSize="11" Text="{x:Bind Package}" />
                                        </Border>
                                                <Border MinHeight="24" Padding="8,2" Background="{ThemeResource ControlFillColorTertiaryBrush}" CornerRadius="12" VerticalAlignment="Center">
                                            <TextBlock FontSize="11" Text="{x:Bind OwnedBadgeText}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                                </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <Border
                    Grid.Row="1"
                    Margin="0,18,0,0"
                    Padding="24"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="18"
                    Visibility="{x:Bind EmptyStateVisibility, Mode=OneWay}">
                    <StackPanel HorizontalAlignment="Center" Spacing="10" VerticalAlignment="Center">
                        <FontIcon HorizontalAlignment="Center" FontSize="28" Glyph="&#xE711;" />
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="没有找到匹配元件" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource MutedBodyTextStyle}"
                            Text="试试减少关键词，或者先切回“全部”分类再搜索。"
                            TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>

    <!-- This one editor host is reparented into the narrow-layout ContentDialog. -->
    <Border
            x:Name="EditorPane"
            Grid.Column="2"
            MinWidth="0"
            Visibility="Collapsed"
            Style="{StaticResource SidebarSurfaceStyle}">
            <ScrollViewer
                Padding="4,4,8,4"
                Background="Transparent"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <Border
                        Padding="16"
                        CornerRadius="14"
                        Style="{StaticResource SectionCardStyle}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{x:Bind DetailTitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="{x:Bind DetailSubtitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                                <Button
                                    x:Name="EditorCloseButton"
                                    Grid.Column="1"
                                    Click="EditorCloseButton_Click"
                                    Content="关闭"
                                    ToolTipService.ToolTip="关闭编辑面板"
                                    Visibility="Collapsed" />
                            </Grid>

                            <TextBox Header="名称" Text="{x:Bind EditableName, Mode=TwoWay}" />
                            <TextBox Header="型号" Text="{x:Bind EditablePartNumber, Mode=TwoWay}" />
                            <ComboBox
                                Header="大类"
                                DisplayMemberPath="Label"
                                ItemsSource="{x:Bind EditorMajorCategories, Mode=OneWay}"
                                SelectedValue="{x:Bind EditableMajorCategoryId, Mode=TwoWay}"
                                SelectedValuePath="Id"
                                SelectionChanged="EditorMajorCategoryComboBox_SelectionChanged" />
                            <ComboBox
                                Header="子类"
                                DisplayMemberPath="Label"
                                ItemsSource="{x:Bind EditorSubcategories, Mode=OneWay}"
                                SelectedValue="{x:Bind EditableSubCategoryId, Mode=TwoWay}"
                                SelectedValuePath="Id" />
                            <AutoSuggestBox
                                x:Name="PackageEditorBox"
                                Header="封装"
                                PlaceholderText="输入新封装"
                                Text="{x:Bind EditablePackage, Mode=TwoWay}"
                                TextChanged="PackageEditorBox_TextChanged"
                                TextMemberPath="Value"
                                QuerySubmitted="PackageEditorBox_QuerySubmitted">
                                <AutoSuggestBox.QueryIcon>
                                    <FontIcon Glyph="&#xE70D;" />
                                </AutoSuggestBox.QueryIcon>
                            </AutoSuggestBox>
                            <TextBox Header="位置" Text="{x:Bind EditableLocation, Mode=TwoWay}" />
                            <ComboBox
                                Header="记录来源"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind SourceTypeOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind EditableSourceTypeLabel, Mode=TwoWay}" />
                            <TextBox Header="别名" PlaceholderText="1117 LDO | AMS1117" Text="{x:Bind EditableAliases, Mode=TwoWay}" />
                            <TextBox Header="关键词" PlaceholderText="regulator | 3.3v" Text="{x:Bind EditableKeywords, Mode=TwoWay}" />
                            <TextBox Header="替代料" PlaceholderText="ME6211 | XC6206" Text="{x:Bind EditableSubstitutes, Mode=TwoWay}" />
                            <TextBox Header="参数" Text="{x:Bind EditableAttributes, Mode=TwoWay}" />
                            <ToggleSwitch Header="是否持有" IsOn="{x:Bind EditableOwned, Mode=TwoWay}" OffContent="未持有" OnContent="持有" />
                            <TextBox
                                Height="80"
                                AcceptsReturn="True"
                                Header="备注"
                                Text="{x:Bind EditableNotes, Mode=TwoWay}"
                                TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="{x:Bind LastActionText, Mode=OneWay}" TextWrapping="Wrap" />

                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                <Button Click="DeleteButton_Click" Content="删除" IsEnabled="{x:Bind HasSelectedItem, Mode=OneWay}" />
                                <Button Click="SaveButton_Click" Content="保存" Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
