<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ComponentCatalogWinUI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ComponentCatalogWinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:ComponentCatalogWinUI.Models"
    mc:Ignorable="d">

    <Grid ColumnSpacing="16" Padding="20,16,20,16">
        <Grid.ColumnDefinitions>
            <!-- 左侧分类与结构化筛选 -->
            <ColumnDefinition Width="240" />
            <!-- 中间检索结果网格大盘 -->
            <ColumnDefinition Width="*" />
            <!-- 右侧属性编辑表单 -->
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <!-- ================= 第 0 列：分类与筛选 (左) ================= -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <!-- 分类卡片 -->
                <Border
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="分类" />
                        <StackPanel x:Name="SidebarCategoryHost" Spacing="8" />
                    </StackPanel>
                </Border>

                <!-- 结构化筛选卡片 -->
                <Border
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="结构化筛选" />
                        <ComboBox
                            x:Name="SidebarPackageComboBox"
                            Header="封装"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="SidebarPackageComboBox_SelectionChanged" />
                        <ComboBox
                            x:Name="SidebarOwnedComboBox"
                            Header="持有状态"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="SidebarOwnedComboBox_SelectionChanged" />
                        <TextBox
                            x:Name="SidebarAttributeTextBox"
                            Header="属性过滤"
                            PlaceholderText="例如 voltage=3.3V"
                            TextChanged="SidebarAttributeTextBox_TextChanged" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= 第 1 列：检索结果网格大盘 (中) ================= -->
        <Grid Grid.Column="1" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="16" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="SearchBox"
                PlaceholderText="搜索型号、封装、参数"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged"
                VerticalAlignment="Center" />
            <Button
                Grid.Column="1"
                Click="NewComponentButton_Click"
                Content="新建空白元件"
                Style="{StaticResource AccentButtonStyle}"
                VerticalAlignment="Center" />
        </Grid>

            <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SectionCardStyle}" Padding="18,16">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="目录总数" />
                    <TextBlock FontSize="30" FontWeight="SemiBold" Text="{x:Bind TotalCount, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}" Padding="18,16">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="已持有" />
                    <TextBlock FontSize="30" FontWeight="SemiBold" Text="{x:Bind OwnedCount, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}" Padding="18,16">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="分类数" />
                    <TextBlock FontSize="30" FontWeight="SemiBold" Text="{x:Bind CategoryCount, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>

            <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="检索结果" />
                </StackPanel>

                <GridView
                    x:Name="ComponentGrid"
                    Grid.Row="1"
                    IsItemClickEnabled="True"
                    ItemClick="ComponentGrid_ItemClick"
                    ItemsSource="{x:Bind FilteredItems, Mode=OneWay}"
                    Margin="0,18,0,0"
                    SelectedItem="{x:Bind SelectedItem, Mode=OneWay}"
                    SelectionMode="Single"
                    SizeChanged="ComponentGrid_SizeChanged"
                    Visibility="{x:Bind ResultListVisibility, Mode=OneWay}">
                    
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0,0,12,12" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewItem">
                                        <Grid CornerRadius="14" Background="Transparent">
                                            <!-- 底层卡片内容 -->
                                            <ContentPresenter x:Name="ContentPresenter"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              Content="{TemplateBinding Content}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                                            <!-- 中层：悬浮微光背景层 -->
                                            <Border x:Name="HoverBackground"
                                                    CornerRadius="14"
                                                    Background="{ThemeResource SystemAccentColor}"
                                                    Opacity="0"
                                                    IsHitTestVisible="False" />
                                            
                                            <!-- 顶层：选中状态边框层 -->
                                            <Border x:Name="SelectionBorder"
                                                    CornerRadius="14"
                                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                    BorderThickness="1.5"
                                                    Opacity="0"
                                                    IsHitTestVisible="False" />
                                            
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal" />
                                                    <VisualState x:Name="PointerOver">
                                                        <VisualState.Setters>
                                                            <Setter Target="HoverBackground.Opacity" Value="0.08" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Pressed">
                                                        <VisualState.Setters>
                                                            <Setter Target="HoverBackground.Opacity" Value="0.15" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                                <VisualStateGroup x:Name="SelectionStates">
                                                    <VisualState x:Name="Unselected" />
                                                    <VisualState x:Name="Selected">
                                                        <VisualState.Setters>
                                                            <Setter Target="SelectionBorder.Opacity" Value="1" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="SelectedUnfocused">
                                                        <VisualState.Setters>
                                                            <Setter Target="SelectionBorder.Opacity" Value="1" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GridView.ItemContainerStyle>

                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Stretch" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="model:ComponentItem">
                            <Border
                                Height="145"
                                Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                HorizontalAlignment="Stretch">
                                <Grid RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- 头部区：Icon + 名称/型号/位置 (位置移到左侧垂直排版) -->
                                    <Grid Grid.Row="0" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="38"
                                            Height="38"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                            CornerRadius="10"
                                            VerticalAlignment="Top">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Glyph="{x:Bind CategoryGlyph}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            <TextBlock FontSize="12" Style="{StaticResource SectionCaptionTextStyle}" Text="{x:Bind PartNumber}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            <StackPanel Orientation="Horizontal" Spacing="4" Opacity="0.7">
                                                <FontIcon Glyph="&#xE81D;" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock FontSize="11" Text="{x:Bind Location}" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 标签区 (字号调整为较清晰的 11) -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                                        <Border Padding="6,2" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4">
                                            <TextBlock FontSize="11" Text="{x:Bind Category}" />
                                        </Border>
                                        <Border Padding="6,2" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="4">
                                            <TextBlock FontSize="11" Text="{x:Bind Package}" />
                                        </Border>
                                        <Border Padding="6,2" Background="{ThemeResource ControlFillColorTertiaryBrush}" CornerRadius="4">
                                            <TextBlock FontSize="11" Text="{x:Bind OwnedBadgeText}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- 备注区 (字号调整为 12) -->
                                    <TextBlock
                                        Grid.Row="2"
                                        FontSize="12"
                                        Opacity="0.7"
                                        Text="{x:Bind Notes}"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="2"
                                        VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <Border
                    Grid.Row="1"
                    Margin="0,18,0,0"
                    Padding="24"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="18"
                    Visibility="{x:Bind EmptyStateVisibility, Mode=OneWay}">
                    <StackPanel HorizontalAlignment="Center" Spacing="10" VerticalAlignment="Center">
                        <FontIcon HorizontalAlignment="Center" FontSize="28" Glyph="&#xE711;" />
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="没有找到匹配元件" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource MutedBodyTextStyle}"
                            Text="试试减少关键词，或者先切回“全部”分类再搜索。"
                            TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>

    <Border
            Grid.Column="2"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
            <ScrollViewer Padding="20">
                <StackPanel Spacing="16">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{x:Bind DetailTitle, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="{x:Bind DetailSubtitle, Mode=OneWay}" />
                            </StackPanel>

                            <TextBox Header="名称" Text="{x:Bind EditableName, Mode=TwoWay}" />
                            <TextBox Header="型号" Text="{x:Bind EditablePartNumber, Mode=TwoWay}" />
                            <AutoSuggestBox
                                x:Name="CategoryEditorBox"
                                Header="分类"
                                TextMemberPath="Value"
                                PlaceholderText="输入新分类"
                                Text="{x:Bind EditableCategory, Mode=TwoWay}"
                                TextChanged="CategoryEditorBox_TextChanged"
                                QuerySubmitted="CategoryEditorBox_QuerySubmitted">
                                <AutoSuggestBox.QueryIcon>
                                    <FontIcon Glyph="&#xE70D;" />
                                </AutoSuggestBox.QueryIcon>
                            </AutoSuggestBox>
                            <AutoSuggestBox
                                x:Name="PackageEditorBox"
                                Header="封装"
                                TextMemberPath="Value"
                                PlaceholderText="输入新封装"
                                Text="{x:Bind EditablePackage, Mode=TwoWay}"
                                TextChanged="PackageEditorBox_TextChanged"
                                QuerySubmitted="PackageEditorBox_QuerySubmitted">
                                <AutoSuggestBox.QueryIcon>
                                    <FontIcon Glyph="&#xE70D;" />
                                </AutoSuggestBox.QueryIcon>
                            </AutoSuggestBox>
                            <TextBox Header="位置" Text="{x:Bind EditableLocation, Mode=TwoWay}" />
                            <ComboBox
                                Header="记录来源"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind SourceTypeOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind EditableSourceTypeLabel, Mode=TwoWay}" />
                            <TextBox Header="别名" PlaceholderText="1117 LDO | AMS1117" Text="{x:Bind EditableAliases, Mode=TwoWay}" />
                            <TextBox Header="关键词" PlaceholderText="regulator | 3.3v" Text="{x:Bind EditableKeywords, Mode=TwoWay}" />
                            <TextBox Header="替代料" PlaceholderText="ME6211 | XC6206" Text="{x:Bind EditableSubstitutes, Mode=TwoWay}" />
                            <TextBox Header="参数" Text="{x:Bind EditableAttributes, Mode=TwoWay}" />
                            <ToggleSwitch Header="是否持有" IsOn="{x:Bind EditableOwned, Mode=TwoWay}" OnContent="持有" OffContent="未持有" />
                            <TextBox
                                Header="备注"
                                AcceptsReturn="True"
                                Height="80"
                                Text="{x:Bind EditableNotes, Mode=TwoWay}"
                                TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="{x:Bind LastActionText, Mode=OneWay}" />

                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                <Button Click="DeleteButton_Click" Content="删除" IsEnabled="{x:Bind HasSelectedItem, Mode=OneWay}" />
                                <Button Click="SaveButton_Click" Content="保存" Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
