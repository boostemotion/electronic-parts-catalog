<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ComponentCatalogWinUI.Pages.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="36,24,36,24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="24">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="False" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <!-- 标题行 -->
            <StackPanel Spacing="6">
                <TextBlock FontSize="28" FontWeight="Bold" Text="批量导入元件" />
                <TextBlock Style="{StaticResource MutedBodyTextStyle}" Text="直接选择本地 CSV 文件，或者在此粘贴 CSV 文本进行解析入库。" />
            </StackPanel>

            <!-- AI 辅助提取 -->
            <Border
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="AI 辅助提取" />
                    <TextBlock
                        Style="{StaticResource MutedBodyTextStyle}"
                        Text="先把标准提示词和原始 BOM 交给 AI；无法确认的料必须排除，不能以“未分类”进入数据库。"
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Left"
                        Click="CopyAiPromptButton_Click"
                        Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            <TextBlock Text="复制 AI 提示词" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        Style="{StaticResource MutedBodyTextStyle}"
                        Text="AI 输出仍需经过本地预览和提交门禁。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 导入主卡片 -->
            <Border
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="CSV 数据源" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Click="SelectCsvFileButton_Click" Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                <TextBlock Text="选择 CSV 文件" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBox
                        x:Name="ImportTextBox"
                        AcceptsReturn="True"
                        Height="260"
                        PlaceholderText="在此输入或粘贴符合规范的 CSV 元件数据..."
                        TextWrapping="Wrap"
                        FontFamily="Consolas" />

                    <StackPanel Spacing="8">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="选择导入策略" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Click="ImportStrategyButton_Click" Content="仅跳过重复" Tag="skip" Padding="14,8" />
                            <Button Click="ImportStrategyButton_Click" Content="合并至别名" Tag="merge" Padding="14,8" />
                            <Button Click="ImportStrategyButton_Click" Content="强行覆盖" Style="{StaticResource AccentButtonStyle}" Tag="overwrite" Padding="14,8" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 状态日志卡片 -->
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="导入状态日志" />
                    <TextBlock
                        x:Name="ImportStatusText"
                        Style="{StaticResource MutedBodyTextStyle}"
                        Text="等待文件载入或数据录入..."
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="ImportErrorDetailsText"
                        FontFamily="Consolas"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
