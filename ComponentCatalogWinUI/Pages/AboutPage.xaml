<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ComponentCatalogWinUI.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ComponentCatalogWinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24,18,24,24" Spacing="16">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="False" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="关于" />
                <TextBlock Style="{StaticResource MutedBodyTextStyle}" Text="电子元件入库台是基于 WinUI 3 的 Windows 桌面元件目录与库存管理工具。" />
            </StackPanel>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="版本" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="应用版本：" />
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind AppVersion}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="分类协议：" />
                        <TextBlock FontWeight="SemiBold" Text="v1" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="当前能力" />
                    <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="Windows 端已支持元件目录检索、新增、编辑、删除、批量 CSV 导入和库存信息维护，并使用项目目录中的 SQLite 作为写入真源。" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="数据与集成" />
                    <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="应用会生成标准 JSON 快照，并提供受 Bearer 令牌保护的本地 HTTP API，供其他应用或自动化工具读取和同步同一份元件目录。" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
