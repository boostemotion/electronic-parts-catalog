<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ComponentCatalogWinUI.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ComponentCatalogWinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24,18,24,24" Spacing="16">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="关于" />
                <TextBlock Style="{StaticResource MutedBodyTextStyle}" Text="这是电子元件入库台的 WinUI 3 原生壳，目标是提供更接近 Windows 设置的 Fluent 桌面体验。" />
            </StackPanel>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="当前阶段" />
                    <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="Windows 端负责维护目录、搜索和详情编辑；Android 首版只读查询。当前已完成 WinUI 3 桌面骨架与本地交互原型。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="下一步" />
                    <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="接入 SQLite、标准 JSON 导出、CSV 导入规则和本地只读 API，让其他应用或 AI 可以读取同一份目录数据。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
